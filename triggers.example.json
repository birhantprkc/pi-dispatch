{
  "triggers": [
    { "on": { "type": "cron", "id": "nightly-tidy", "pattern": "0 3 * * *" }, "run": { "kind": "local", "folder": "/absolute/path/to/your/project", "flow": "tidy", "task": "dedupe imports and run the formatter" } },
    { "on": { "type": "label", "any": ["pi:frontend"] }, "run": { "kind": "github", "flow": "frontend-fix" } },
    { "on": { "type": "comment", "phrase": "@pi" }, "run": { "kind": "github", "flow": "fix" } },
    { "on": { "type": "pull_request", "action": ["labeled"], "any": ["pi:review"] }, "run": { "kind": "github", "flow": "review" } },
    { "on": { "type": "pull_request", "action": ["opened", "synchronize"] }, "run": { "kind": "github", "flow": "review" } }
  ]
}
