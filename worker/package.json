{
  "name": "@pi-dispatch/worker",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "BullMQ worker: drains the queue, mints scoped tokens, runs one container per job.",
  "license": "MIT",
  "main": "src/index.mjs",
  "bin": {
    "pi-dispatch": "src/cli.mjs"
  },
  "exports": {
    ".": "./src/index.mjs",
    "./config": "./src/config.mjs",
    "./queue": "./src/queue.mjs",
    "./connection": "./src/connection.mjs",
    "./job-id": "./src/job-id.mjs",
    "./identity": "./src/identity.mjs",
    "./get-token": "./src/get-token.mjs",
    "./runtime-settings": "./src/runtime-settings.mjs",
    "./run-history": "./src/run-history.mjs",
    "./budget": "./src/budget.mjs"
  },
  "engines": {
    "node": ">=22.19.0"
  },
  "scripts": {
    "test": "node --test \"test/*.test.mjs\"",
    "start": "node src/cli.mjs worker"
  },
  "dependencies": {
    "@earendil-works/pi-ai": "0.80.7",
    "@octokit/auth-app": "8.2.0",
    "@octokit/rest": "22.0.1",
    "bullmq": "5.80.4",
    "ioredis": "5.11.1"
  }
}
